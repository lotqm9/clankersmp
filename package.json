{
  "name": "steve-craft-survival",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "$STEVE Craft survival: the game client (Vite + three.js, built into sites/steve/play) and the game server (Node + ws).",
  "scripts": {
    "dev:client": "node node_modules/vite/bin/vite.js",
    "build:client": "node node_modules/vite/bin/vite.js build",
    "dev:server": "node server/src/main.ts",
    "build:server": "node tools/build-server.mjs",
    "build": "npm run build:server && npm run build:client",
    "test": "node --test --test-concurrency=1 \"tests/*.test.ts\"",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit -p .",
    "loadtest": "node tests/loadtest.ts 50 40"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/three": "^0.185.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.12",
    "obscenity": "^0.4.6",
    "three": "^0.185.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "ws": "^8.22.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0"
  }
}
